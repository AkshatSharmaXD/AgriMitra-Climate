# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/agrimitra

# Server port
PORT=5000

# URL for the Python ML service
ML_SERVICE_URL=http://localhost:8000

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key

# data.gov.in API key for market data
DATA_GOV_API_KEY=your_data_gov_api_key

# OpenWeather API key (optional for open-meteo)
OPENWEATHER_API_KEY=your_openweather_api_key

# Google Earth Engine service account credentials (JSON string)
GEE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
