ENVIRONMENT=development
LOG_LEVEL=INFO

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agrimitra

# Explicit allowlist — never "*"
CORS_ORIGINS=["http://localhost:3000"]

# Google Gemini. Absent -> advisory falls back to a labelled deterministic summary.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Earth Engine service account JSON, as a single-line string.
# Absent -> satellite data comes from the seeded demo dataset, labelled as such.
GEE_SERVICE_ACCOUNT_JSON=

# data.gov.in (Agmarknet market prices). Absent -> /market returns 503.
DATA_GOV_API_KEY=

INFERENCE_SERVICE_URL=http://localhost:8001
