ENVIRONMENT=development
LOG_LEVEL=INFO

# --- MongoDB Atlas ----------------------------------------------------------
# Atlas connection string. Contains a password, so in any deployed environment
# this comes from Google Secret Manager and is never baked into an image.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Requires the `pymongo[srv]` extra (declared in pyproject.toml) for the +srv form.
# Atlas > Network Access must allow the caller's IP; Cloud Run needs either
# 0.0.0.0/0 or a VPC connector with a static egress IP.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agrimitra

# Server selection headroom. Atlas shared tiers can be slow to first respond.
MONGODB_TIMEOUT_MS=10000
# Shared tiers cap concurrent connections — keep the pool modest per instance.
MONGODB_MAX_POOL_SIZE=20

# --- CORS -------------------------------------------------------------------
# Explicit allowlist, never "*".
CORS_ORIGINS=["http://localhost:3000"]

# --- Google ------------------------------------------------------------------
# Absent -> advisory falls back to a labelled deterministic summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Earth Engine service account JSON as a single-line string.
# Absent -> satellite data comes from the seeded demo dataset, labelled as such.
GEE_SERVICE_ACCOUNT_JSON=

# data.gov.in (Agmarknet). Absent -> /market returns 503, never an estimated price.
DATA_GOV_API_KEY=

# --- Vertex AI ---------------------------------------------------------------
# Reach the same Gemini models through Vertex using the runtime service account's
# IAM identity, so a Cloud Run deployment stores no API key at all.
USE_VERTEX_AI=false
GCP_PROJECT=
GCP_LOCATION=asia-south1

# --- Google Cloud services ----------------------------------------------------
# Leaf-scan photos. Absent -> the diagnosis is stored without its image.
GCS_BUCKET=
# Server-side speech for browsers with no Web Speech API. Needs GCP_PROJECT.
ENABLE_CLOUD_SPEECH=false
# Scheme directory in the farmer's language. Needs GCP_PROJECT.
ENABLE_TRANSLATION=false
# Append-only risk time series for district/state trends.
BIGQUERY_DATASET=
# Fan-out topic for out-of-band NDVI refresh.
PUBSUB_TOPIC_NDVI_REFRESH=

# --- Cache --------------------------------------------------------------------
# Memorystore or local Redis. Absent -> every lookup hits the upstream API.
REDIS_URL=

INFERENCE_SERVICE_URL=http://localhost:8001
